# ── Core (required) ──────────────────────────────────────────────────────────

# Generate with: openssl rand -hex 32
JWT_SECRET=

# SQL Server connection string — see README for all supported formats
DATABASE_URL=Server=localhost;Database=ProjectManagement;User Id=sa;Password=YourPassword;

# ── Core (optional) ───────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development
APP_ID=project-management-app

# ── Azure DevOps Boards ───────────────────────────────────────────────────────
# Remove comments and fill in to enable live KPI sync from Azure Boards

# AZURE_DEVOPS_ORG=mycompany
# AZURE_DEVOPS_PROJECT=MyProject
# AZURE_DEVOPS_PAT=
# AZURE_DEVOPS_TEAM=MyProject Team
# AZURE_SYNC_ENABLED=true
# AZURE_SYNC_INTERVAL_MINUTES=60

# ── Microsoft Entra ID SSO ────────────────────────────────────────────────────
# All four required to enable SSO. See docs/ENTRA_ACTIVATION_GUIDE.md.

# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/entra/callback

# Entra group → role mapping (optional)
# ENTRA_GROUP_ADMIN=
# ENTRA_GROUP_EXECUTIVE=
# ENTRA_GROUP_COMPANY=

# ── Duo Security MFA ──────────────────────────────────────────────────────────
# All four required to enforce MFA. See docs/DUO_ACTIVATION_GUIDE.md.

# DUO_CLIENT_ID=
# DUO_CLIENT_SECRET=
# DUO_API_HOST=api-xxxxxxxx.duosecurity.com
# DUO_REDIRECT_URL=http://localhost:3000/duo-callback
